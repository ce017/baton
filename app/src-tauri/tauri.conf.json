{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Baton",
  "mainBinaryName": "Baton",
  "version": "0.3.3",
  "identifier": "dev.ceo.baton",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Baton",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f6f5f2"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "ceo",
    "shortDescription": "Shared workspace for people and their Claudes",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxQjY0QUU0Q0NDNjhBNDgKUldSSWlzYk01RXEyOFRZakFQTXYxNnhlSVVFU1FXUEVWVll2Zmg3azNMSXpYemRQZlhjNEtqbmEK",
      "endpoints": [
        "https://github.com/ce017/baton/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
