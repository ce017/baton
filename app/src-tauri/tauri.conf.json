{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Baton",
  "mainBinaryName": "Baton",
  "version": "0.1.0",
  "identifier": "dev.ceo.baton",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Baton",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f6f5f2"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ceo",
    "shortDescription": "Shared workspace for people and their Claudes",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
